<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
    <h1>{{title}}</h1>
    <hr>
    {{#if Carts}}
        {{#each Carts}}
            <p><strong>Product ID:</strong> {{this.productID}} - <strong>Quantity:</strong> {{this.quantity}}</p>
        {{/each}}
    {{/if}}

    {{#if message}}
        <p><strong>{{type}}:</strong> {{message}}</p>
    {{/if}}
</body>
</html>
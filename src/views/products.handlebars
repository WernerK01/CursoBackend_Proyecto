<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
</head>
<body>
  <h1>{{title}}</h1>
  <hr>
  {{#if Products}}
      <ul>
        {{#each Products}}
          <li><strong>{{this.name}}</strong> - <strong>Stock:</strong> ${{this.stock}} - <strong>Price:</strong> ${{this.price}}</li>
        {{/each}}
      </ul>
    {{/if}}

    {{#if message}}
      <p><strong>{{type}}:</strong> {{message}}</p>
    {{/if}}
</body>
</html>